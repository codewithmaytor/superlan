# Public contact email stays hidden until mailbox sending/receiving is verified.
NEXT_PUBLIC_EMAIL_ENABLED=false

# All values below are server-only. Add them in Vercel project environment settings.
# Copy the exact outgoing host from Truehost Workplace mailbox client settings/support, not a guess.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=info@superlan.co.ke
CONTACT_TO=info@superlan.co.ke
# CONTACT_TO may later be quotations@superlan.co.ke after that mailbox works.

# Shared spam limits across Vercel function instances. Create a Redis database
# through the Vercel Marketplace or Upstash; do not commit its credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace automatically adds KV_REST_API_URL and KV_REST_API_TOKEN.
# The app also accepts that complete pair; no need to copy or rename secrets.
